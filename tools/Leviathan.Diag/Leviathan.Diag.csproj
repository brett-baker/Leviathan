<Project Sdk="Microsoft.NET.Sdk">
  <!-- leviathan-diag: read crash bundles from the command line, e.g. from Claude Code in the repository (spec §20.4). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <RootNamespace>Leviathan.Diag</RootNamespace>
    <AssemblyName>leviathan-diag</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Leviathan.Diagnostics\Leviathan.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
