<Project>
  <!-- Shared build settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFrameworkVersion>net10.0</TargetFrameworkVersion>
    <TargetWindowsVersion>10.0.26100.0</TargetWindowsVersion>
    <MinimalWindowsVersion>10.0.22621.0</MinimalWindowsVersion>
    <WindowsTargetFramework>$(TargetFrameworkVersion)-windows$(TargetWindowsVersion)</WindowsTargetFramework>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs on public members. Docs are required on contracts, not everywhere. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Every process ships as x64 or ARM64 (spec §2.4). -->
    <Platforms>x64;ARM64</Platforms>

    <!-- Diagnosable builds (spec §20.1): deterministic, SourceLink, embedded portable PDBs. -->
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <Company>Leviathan</Company>
    <Product>Leviathan</Product>
    <Copyright>Copyright (c) Brett Baker</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test names use underscores: Method_State_Expectation. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1852</NoWarn>
  </PropertyGroup>
</Project>
