<Project Sdk="Microsoft.NET.Sdk">
  <!-- Performance budgets (spec section 3.1). Pass the "gate" switch (see README) for the quick Phase 0 enumeration gate;
       without arguments it runs the full BenchmarkDotNet suite. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <!-- On Windows the NAS copy benchmark uses the real Windows copier, so the project targets Windows there. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(WindowsTargetFramework)</TargetFramework>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS_TFM</DefineConstants>
    <RootNamespace>Leviathan.Benchmarks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Leviathan.Providers.Local\Leviathan.Providers.Local.csproj" />
    <ProjectReference Include="..\..\src\Leviathan.ViewModels\Leviathan.ViewModels.csproj" />
    <ProjectReference Include="..\..\src\Leviathan.Engine\Leviathan.Engine.csproj" />
    <ProjectReference Include="..\..\src\Leviathan.Media.Core\Leviathan.Media.Core.csproj" />
    <ProjectReference Include="..\Leviathan.Testing\Leviathan.Testing.csproj" />
    <ProjectReference Include="..\..\src\Leviathan.Contracts\Leviathan.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Leviathan.Interop\Leviathan.Interop.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
</Project>
