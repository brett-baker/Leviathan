<Project Sdk="Microsoft.NET.Sdk">
  <!-- Smoke tests that drive the real app through UI Automation (spec 19, build plan H1). They start Leviathan.exe with its own data folder. -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Leviathan.UI.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built first so the exe is there; nothing of it is referenced. -->
    <ProjectReference Include="..\..\src\Leviathan.App\Leviathan.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
