<Project Sdk="Microsoft.NET.Sdk">
  <!-- ffprobe runner, parser and cache tests (spec 19): fakes first, then the real ffprobe on small generated clips when it is installed. -->
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Leviathan.Media.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Leviathan.Media.Core\Leviathan.Media.Core.csproj" />
    <ProjectReference Include="..\Leviathan.Testing\Leviathan.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ffprobe output of generated clips (tools/New-MediaSamples.ps1) and the parsed results the tests expect. -->
    <None Include="Samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
