<Project Sdk="Microsoft.NET.Sdk">
  <!-- Space map without a UI: the folder tree with sizes, the squarified treemap layout, colouring and the scan that fills it (spec 14). Plain net10.0 so it is unit-tested everywhere. -->
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <RootNamespace>Leviathan.SpaceMap</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Leviathan.SpaceMap.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Leviathan.Core\Leviathan.Core.csproj" />
    <ProjectReference Include="..\Leviathan.Search.Core\Leviathan.Search.Core.csproj" />
  </ItemGroup>
</Project>
