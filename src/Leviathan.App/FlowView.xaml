<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.FlowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    AutomationProperties.Name="Files">

  <!-- Spec 8.1: List (columns of names, scrolls sideways) and Thumbnails (a wrapping grid, scrolls down). -->
  <ScrollViewer x:Name="Scroller"
                IsTabStop="False"
                AllowFocusOnInteraction="False"
                ZoomMode="Disabled"
                PointerPressed="OnBodyPointerPressed"
                DoubleTapped="OnBodyDoubleTapped"
                RightTapped="OnBodyRightTapped">
    <muxc:ItemsRepeater x:Name="Repeater" Margin="4" />
  </ScrollViewer>
</UserControl>
