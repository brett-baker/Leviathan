<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Leviathan.App.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows">

  <Grid x:Name="Root" Background="Black" KeyDown="OnKeyDown" IsTabStop="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <vlc:VideoView x:Name="Video" Initialized="OnVideoInitialized" />
    <TextBlock x:Name="Message" TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Foreground="White" />

    <Grid Grid.Row="1" Padding="12,6" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="PlayButton" Content="Play" Click="OnPlayClick" MinWidth="64" />
      <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center" Text="0:00 / 0:00" MinWidth="110" />
      <Slider x:Name="Seek" Grid.Column="2" Minimum="0" Maximum="1" StepFrequency="0.001" VerticalAlignment="Center" ValueChanged="OnSeekChanged" IsTabStop="False" />
      <TextBlock x:Name="SpeedText" Grid.Column="3" VerticalAlignment="Center" Text="1×" MinWidth="40" TextAlignment="Right" />
    </Grid>
  </Grid>
</Window>
