<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.SettingsSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leviathan.App"
    xmlns:settings="using:Leviathan.ViewModels.Settings"
    xmlns:commands="using:Leviathan.ViewModels.Commands">

  <UserControl.Resources>
    <DataTemplate x:Key="PageTemplate" x:DataType="settings:SettingsPageInfo">
      <StackPanel Padding="4,6" Spacing="1">
        <TextBlock Text="{x:Bind Title}" />
        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ResultTemplate" x:DataType="settings:SettingEntry">
      <StackPanel Padding="4,6" Spacing="1">
        <TextBlock Text="{x:Bind Title}" />
        <TextBlock Text="{x:Bind local:SettingsFormat.Where(PageId)}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="KeyRowTemplate" x:DataType="commands:KeyboardRow">
      <Grid ColumnSpacing="12" Padding="4,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="70" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="2" Text="{x:Bind local:SettingsFormat.Keys(Keys)}" FontFamily="Consolas" />
        <TextBlock Grid.Column="3" Text="{x:Bind local:SettingsFormat.Changed(IsCustom)}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      </Grid>
    </DataTemplate>
    <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    <Style x:Key="SettingNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Border x:Name="Frame" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0" CornerRadius="8,8,0,0">
    <Grid RowSpacing="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Padding="16,10,12,4" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="520" PlaceholderText="Search all settings" TextChanged="OnSearchChanged"
                 AutomationProperties.Name="Search all settings" />
        <Button x:Name="ExpandButton" Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnExpandClick"
                AutomationProperties.Name="Expand" ToolTipService.ToolTip="Fill the window" />
        <Button x:Name="CloseButton" Grid.Column="3" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseClick"
                AutomationProperties.Name="Close settings" ToolTipService.ToolTip="Close (Esc)" />
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="PageList" Padding="8,0" SelectionMode="Single" ItemTemplate="{StaticResource PageTemplate}" SelectionChanged="OnPageSelected" />

        <Grid Grid.Column="1">
          <ListView x:Name="ResultList" Visibility="Collapsed" Padding="8,0" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnResultClick"
                    ItemTemplate="{StaticResource ResultTemplate}" />
          <TextBlock x:Name="NoResults" Text="No setting matches that." Margin="16,8,0,0" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

          <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
            <Grid Padding="20,8,24,24" MaxWidth="760" HorizontalAlignment="Left">
              <!-- General -->
              <StackPanel x:Name="GeneralPage" Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="When the app starts" Style="{StaticResource SettingTitle}" />
                  <ComboBox x:Name="StartupBox" Width="280" SelectionChanged="OnStartupChanged" AutomationProperties.Name="When the app starts">
                    <ComboBoxItem Content="Open where I left off (Last session)" />
                    <ComboBoxItem Content="Open a saved profile" />
                    <ComboBoxItem Content="Ask me" />
                  </ComboBox>
                  <ComboBox x:Name="ProfileBox" Width="280" Visibility="Collapsed" PlaceholderText="Choose a profile" SelectionChanged="OnProfileChanged"
                            AutomationProperties.Name="Startup profile" />
                  <TextBlock Text="Profiles are saved from the Options menu (Save current windows as profile)." Style="{StaticResource SettingNote}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Where a new tab opens" Style="{StaticResource SettingTitle}" />
                  <TextBox x:Name="NewTabBox" Width="420" HorizontalAlignment="Left" PlaceholderText="Home (leave empty)" LostFocus="OnNewTabCommit" KeyDown="OnNewTabKeyDown"
                           AutomationProperties.Name="Where a new tab opens" />
                  <TextBlock x:Name="NewTabNote" Text="A folder such as C:\Projects or \\nas\media. Empty means your user folder." Style="{StaticResource SettingNote}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Open terminal here uses" Style="{StaticResource SettingTitle}" />
                  <ComboBox x:Name="TerminalBox" Width="280" SelectionChanged="OnTerminalChanged" AutomationProperties.Name="Terminal">
                    <ComboBoxItem Content="Windows Terminal (PowerShell when it is not installed)" />
                    <ComboBoxItem Content="Windows PowerShell" />
                    <ComboBoxItem Content="Command Prompt" />
                    <ComboBoxItem Content="WSL (the default distribution)" />
                  </ComboBox>
                </StackPanel>
              </StackPanel>

              <!-- Appearance -->
              <StackPanel x:Name="AppearancePage" Spacing="16" Visibility="Collapsed">
                <RadioButtons x:Name="ThemeButtons" Header="Theme (takes effect the next time the app starts)" SelectionChanged="OnLookChanged" AutomationProperties.Name="Theme">
                  <x:String>Same as Windows</x:String>
                  <x:String>Light</x:String>
                  <x:String>Dark</x:String>
                </RadioButtons>
                <RadioButtons x:Name="DensityButtons" Header="Density" SelectionChanged="OnLookChanged" AutomationProperties.Name="Density">
                  <x:String>Comfortable: roomier rows</x:String>
                  <x:String>Compact: more on the screen</x:String>
                </RadioButtons>
                <StackPanel Spacing="6">
                  <TextBlock Text="Accent colour" Style="{StaticResource SettingTitle}" />
                  <StackPanel x:Name="AccentList" Orientation="Horizontal" Spacing="6" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="AccentBox" Width="140" PlaceholderText="#RRGGBB" LostFocus="OnAccentCommit" KeyDown="OnAccentKeyDown" AutomationProperties.Name="Accent colour as #RRGGBB" />
                    <TextBlock x:Name="AccentNote" Style="{StaticResource SettingNote}" VerticalAlignment="Center" Text="Pick one, or type a colour. The first swatch follows Windows. Windows opened from now on use it; this one has it from the next start." />
                  </StackPanel>
                </StackPanel>
                <ToggleSwitch x:Name="MicaSwitch" Header="Window backdrop (Mica): the colour of your wallpaper shows through" Toggled="OnLookToggled" />
                <RadioButtons x:Name="IconSizeButtons" Header="Icon size in the file list" SelectionChanged="OnLookChanged" AutomationProperties.Name="Icon size">
                  <x:String>Small (16)</x:String>
                  <x:String>Medium (20)</x:String>
                  <x:String>Large (24)</x:String>
                </RadioButtons>
                <StackPanel Spacing="4">
                  <TextBlock Text="Icon set" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="The icons of the toolbar, the sidebar, tabs and menus. The change shows at once." Style="{StaticResource SettingNote}" />
                  <StackPanel x:Name="IconPackList" Spacing="2" />
                </StackPanel>
              </StackPanel>

              <!-- Files and folders -->
              <StackPanel x:Name="FilesPage" Spacing="14" Visibility="Collapsed">
                <ToggleSwitch x:Name="HiddenSwitch" Header="Show hidden files and folders" Toggled="OnFilesToggled" />
                <ToggleSwitch x:Name="SystemSwitch" Header="Show system files and folders" Toggled="OnFilesToggled" />
                <StackPanel Spacing="4">
                  <ToggleSwitch x:Name="SizesSwitch" Header="Show the size of folders" Toggled="OnFilesToggled" />
                  <ToggleSwitch x:Name="EagerSwitch" Header="Show deletes, moves and copies at once" OnContent="Rows go and arrive when you ask; a moved or copied file is dimmed until it is there" OffContent="Rows change as the job reports and when it ends" Toggled="OnFilesToggled" />
                  <TextBlock Text="Counted in the background and kept up to date. Folders on network drives can be left out in the status hub's Quick settings." Style="{StaticResource SettingNote}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBox x:Name="RecheckBox" Header="Count these network drives again every day (one per line)" AcceptsReturn="True" TextWrapping="NoWrap"
                           MinHeight="72" MaxHeight="140" PlaceholderText="Y:\media" LostFocus="OnRecheckLostFocus" HorizontalAlignment="Left" Width="360" />
                  <TextBlock Text="A folder size on a share can only show how old it is, because a change deep inside is not noticed. These drives (mapped drive letters) are counted again in the background once a day, a few minutes after start-up first." Style="{StaticResource SettingNote}" />
                </StackPanel>
                <ToggleSwitch x:Name="GitSwitch" Header="Show Git status in repositories" OnContent="A Git column (add it from the column chooser) and the branch in the status bar; local drives only" OffContent="Git is never asked" Toggled="OnFilesToggled" />
                <StackPanel Spacing="4">
                  <TextBlock Text="Quick move and copy targets" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="Ctrl+Alt+1 to 9 move the selection to the folder in that slot; add Shift to copy. Leave a slot empty to leave it unset." Style="{StaticResource SettingNote}" />
                  <StackPanel x:Name="QuickTargetRows" Spacing="4" />
                </StackPanel>
              </StackPanel>

              <!-- Tabs and windows -->
              <StackPanel x:Name="TabsPage" Spacing="14" Visibility="Collapsed">
                <ToggleSwitch x:Name="LastTabSwitch" Header="Closing the last tab opens your home folder instead of closing the window" Toggled="OnTabsToggled" />
              </StackPanel>

              <!-- Network -->
              <StackPanel x:Name="NetworkPage" Spacing="14" Visibility="Collapsed">
                <TextBlock Text="What Leviathan does over the network" Style="{StaticResource SettingTitle}" />
                <ToggleSwitch x:Name="NetSizesSwitch" Header="Count the size of folders on network drives" OnContent="Each folder means walking the share" OffContent="Folder sizes on shares stay empty (a slow NAS is spared)" Toggled="OnNetworkToggled" />
                <ToggleSwitch x:Name="NetThumbsSwitch" Header="Make thumbnails of files on network drives" OnContent="Each thumbnail means reading the file over the network" OffContent="Pictures on shares show icons only" Toggled="OnNetworkToggled" />
                <TextBlock Style="{StaticResource SettingNote}" Text="A share that stops answering fails fast in its own tab and is tried again with back-off; that is not a setting. The status hub Quick settings tab has the same two switches." />
              </StackPanel>

              <!-- Operations -->
              <StackPanel x:Name="OperationsPage" Spacing="14" Visibility="Collapsed">
                <NumberBox x:Name="RunningBox" Header="Operations at once (copies, moves, deletes)" Minimum="1" Maximum="16" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnOperationsChanged" HorizontalAlignment="Left" Width="260" />
                <NumberBox x:Name="PerDeviceBox" Header="At once on one drive or share" Minimum="1" Maximum="4" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnOperationsChanged" HorizontalAlignment="Left" Width="260" />
                <NumberBox x:Name="BackgroundBox" Header="Background jobs at once (folder sizes, thumbnails)" Minimum="1" Maximum="8" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnOperationsChanged" HorizontalAlignment="Left" Width="260" />
                <StackPanel Spacing="4">
                  <TextBlock Text="Check copies against their sources" Style="{StaticResource SettingTitle}" />
                  <ComboBox x:Name="VerifyBox" Width="360" SelectionChanged="OnOperationsSelectionChanged" AutomationProperties.Name="Verify policy">
                    <ComboBoxItem Content="Default: every move, and copies to or from a share" />
                    <ComboBoxItem Content="Full: every file in full, whatever its size" />
                    <ComboBoxItem Content="Off for copies (moves are still checked)" />
                  </ComboBox>
                </StackPanel>
                <NumberBox x:Name="BandwidthBox" Header="Speed limit (MB per second, 0 = none)" Minimum="0" Maximum="100000" SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Compact" ValueChanged="OnOperationsChanged" HorizontalAlignment="Left" Width="260" />
                <StackPanel Spacing="6">
                  <ToggleSwitch x:Name="ScheduleSwitch" Header="Use a different limit at certain hours" Toggled="OnOperationsToggled" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ScheduleFromBox" Header="From (hh:mm)" Width="110" LostFocus="OnOperationsCommit" KeyDown="OnOperationsKeyDown" />
                    <TextBox x:Name="ScheduleToBox" Header="To (hh:mm)" Width="110" LostFocus="OnOperationsCommit" KeyDown="OnOperationsKeyDown" />
                    <NumberBox x:Name="ScheduleLimitBox" Header="Limit then (MB/s, 0 = none)" Minimum="0" Maximum="100000" SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Compact" ValueChanged="OnOperationsChanged" Width="200" />
                  </StackPanel>
                  <TextBlock x:Name="OperationsNote" Style="{StaticResource SettingNote}" Text="A window that ends earlier than it starts runs past midnight. What to do on a name conflict is asked in the conflict dialog; a standing default is not a setting yet." />
                </StackPanel>
              </StackPanel>

              <!-- Delete -->
              <StackPanel x:Name="DeletePage" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                  <ToggleSwitch x:Name="OwnTrashSwitch" Header="Keep a hidden recycle folder on network shares" Toggled="OnFilesToggled" />
                  <TextBlock Text="Deleted items go to the NAS's own recycle folder (Synology #recycle, QNAP @Recycle) when you can see it, otherwise to a hidden .leviathan-trash so they can be undone. Turn off if your NAS already keeps deletes but hides its bin from you: items then are deleted on the share for the NAS to keep, and Leviathan cannot undo or restore them." Style="{StaticResource SettingNote}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Soft-delete bin" Style="{StaticResource BodyStrongTextBlockStyle}" />
                  <NumberBox x:Name="BinDaysBox" Header="Keep deleted items for (days)" Minimum="0" Maximum="3650" SmallChange="1" LargeChange="10"
                             SpinButtonPlacementMode="Compact" ValueChanged="OnBinLimitChanged" HorizontalAlignment="Left" Width="260" />
                  <NumberBox x:Name="BinSizeBox" Header="Largest the bin may grow (GiB)" Minimum="0" Maximum="100000" SmallChange="10" LargeChange="100"
                             SpinButtonPlacementMode="Compact" ValueChanged="OnBinLimitChanged" HorizontalAlignment="Left" Width="260" />
                  <TextBlock Text="Items deleted from network shares wait here. Once a day, items older than this are deleted for good, and then the oldest ones until the bin is under the size. 0 turns a limit off." Style="{StaticResource SettingNote}" />
                </StackPanel>
              </StackPanel>

              <!-- Media and preview -->
              <StackPanel x:Name="MediaPage" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                  <TextBlock Text="Triage" Style="{StaticResource SettingTitle}" />
                  <ToggleSwitch x:Name="TriageAtEndSwitch" Header="Triage: move kept files when it ends" OnContent="Kept files go to the other pane (or the keep folder) together when you close triage" OffContent="Each file moves as soon as you keep it (recommended: nothing is left waiting)" Toggled="OnTriageToggled" />
                  <ToggleSwitch x:Name="TriageAskSwitch" Header="Triage: ask before moving kept files" Toggled="OnTriageToggled" />
                  <NumberBox x:Name="TriageOffsetBox" Header="Each video starts this many percent in (0 to 90)" Minimum="0" Maximum="90" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="OnMediaChanged" HorizontalAlignment="Left" Width="300" />
                  <ToggleSwitch x:Name="TriageAdvanceSwitch" Header="Go to the next file after a decision" Toggled="OnMediaToggled" />
                  <NumberBox x:Name="TriageDelayBox" Header="Wait this long first (milliseconds, 0 to 1000)" Minimum="0" Maximum="1000" SmallChange="50" SpinButtonPlacementMode="Compact" ValueChanged="OnMediaChanged" HorizontalAlignment="Left" Width="300" />
                  <TextBox x:Name="TriageFolderBox" Header="Keep also moves the file to this folder (empty = leave it)" Width="420" HorizontalAlignment="Left" LostFocus="OnMediaCommit" KeyDown="OnMediaKeyDown" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Skim playback (S)" Style="{StaticResource SettingTitle}" />
                  <NumberBox x:Name="SkimBurstBox" Header="Each burst plays (seconds, 1 to 30)" Minimum="1" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnMediaChanged" HorizontalAlignment="Left" Width="300" />
                  <NumberBox x:Name="SkimIntervalBox" Header="A burst every (percent of the video, 1 to 50)" Minimum="1" Maximum="50" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnMediaChanged" HorizontalAlignment="Left" Width="300" />
                </StackPanel>
                <ToggleSwitch x:Name="HoverScrubSwitch" Header="Slide through a video by moving the mouse over its picture" OnContent="Tiles, Thumbnails and Gallery" OffContent="Pictures stay still" Toggled="OnMediaToggled" />
                <TextBlock Style="{StaticResource SettingNote}" Text="The video engine, hardware decoding, the ffmpeg location and preview size limits are not settings yet: the app picks them itself." />
              </StackPanel>

              <!-- Search and index -->
              <StackPanel x:Name="SearchPage" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="Folders kept in the search index" Style="{StaticResource SettingTitle}" />
                <TextBlock Style="{StaticResource SettingNote}" Text="These folders are listed in the background, one at a time and never while a job copies to the same share, so a search by name is instant. A folder you open also refreshes its entries." />
                <StackPanel x:Name="IndexRows" Spacing="6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox x:Name="IndexAddBox" Width="340" PlaceholderText="A folder such as D:\Photos" KeyDown="OnIndexAddKeyDown" AutomationProperties.Name="Folder to index" />
                  <Button Content="Add" Click="OnIndexAddClick" />
                  <Button x:Name="IndexPauseButton" Content="Pause" Click="OnIndexPauseClick" />
                </StackPanel>
                <TextBlock x:Name="IndexNote" Style="{StaticResource SettingNote}" />
              </StackPanel>

              <!-- Tags -->
              <StackPanel x:Name="TagsPage" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="Colour tags" Style="{StaticResource SettingTitle}" />
                <TextBlock Style="{StaticResource SettingNote}"
                           Text="Keys 1 to 9 tag the selected files with the first nine tags below; Ctrl+0 clears. Moving a tag changes which key it has, never what is already tagged. Tags can be renamed, recoloured and reordered; they cannot be deleted, so a tag on a file never loses its meaning." />
                <StackPanel x:Name="TagRows" Spacing="6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="AddTagButton" Content="Add a tag" Click="OnAddTagClick" />
                  <Button Content="Back to the standard colours and names" Click="OnResetTagsClick" />
                </StackPanel>
                <ToggleSwitch x:Name="TintSwitch" Header="Tint the rows of tagged files with their first tag's colour" Toggled="OnTintToggled" />
                <TextBlock Style="{StaticResource SettingNote}" Text="Writing the Windows Tags property is not built yet." />
              </StackPanel>

              <!-- Advanced -->
              <StackPanel x:Name="AdvancedPage" Spacing="14" Visibility="Collapsed">
                <StackPanel Spacing="4">
                  <TextBlock Text="Settings file" Style="{StaticResource SettingTitle}" />
                  <TextBlock x:Name="SettingsPathText" Style="{StaticResource SettingNote}" IsTextSelectionEnabled="True" />
                  <Button Content="Show the settings file" Click="OnShowSettingsFileClick" />
                  <TextBlock Text="Changes made to the file while the app runs are picked up the next time it starts." Style="{StaticResource SettingNote}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Diagnostics" Style="{StaticResource SettingTitle}" />
                  <TextBlock Text="The worker connection, the job queue and crash reports." Style="{StaticResource SettingNote}" />
                  <Button Content="Open diagnostics" Click="OnDiagnosticsClick" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Caches" Style="{StaticResource SettingTitle}" />
                  <TextBlock x:Name="CacheText" Style="{StaticResource SettingNote}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Clear remembered folders" Click="OnClearListingsClick" />
                    <Button Content="Clear thumbnails" Click="OnClearThumbnailsClick" />
                    <Button Content="Clear the activity log" Click="OnClearActivityClick" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Keyboard -->
              <StackPanel x:Name="KeyboardPage" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="Every command and the keys that run it." Style="{StaticResource SettingTitle}" />
                <TextBlock Style="{StaticResource SettingNote}"
                           Text="Pick a command, click the box and press the new keys. A key another command uses moves to this one, and the page says which. Only your changes are saved; Reset puts the defaults back." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Reset all keys" Click="OnKeysResetAllClick" />
                  <Button Content="Export keys…" Click="OnKeysExportClick" />
                  <Button Content="Import keys…" Click="OnKeysImportClick" />
                  <Button Content="Show the settings file" Click="OnShowSettingsFileClick" />
                  <Button Content="Read the file again" Click="OnReloadFileClick" />
                </StackPanel>
                <TextBlock x:Name="KeyFileNote" Style="{StaticResource SettingNote}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="KeyProblemsText" Style="{StaticResource SettingNote}" Foreground="{ThemeResource SystemFillColorCautionBrush}" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="KeyNotesText" Style="{StaticResource SettingNote}" IsTextSelectionEnabled="True" />
                <Border x:Name="KeyEditor" Visibility="Collapsed" Padding="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="KeyEditorTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBox x:Name="KeyCaptureBox" Width="240" IsReadOnly="True" PlaceholderText="Click here, then press the keys" PreviewKeyDown="OnKeyCapture"
                               AutomationProperties.Name="New keys" />
                      <Button x:Name="KeyApplyButton" Content="Use these keys" IsEnabled="False" Click="OnKeyApplyClick" />
                      <Button x:Name="KeyRemoveButton" Content="No key" Click="OnKeyRemoveClick" ToolTipService.ToolTip="The command keeps working from its menu and the palette; it just has no key" />
                      <Button x:Name="KeyResetButton" Content="Reset" Click="OnKeyResetClick" ToolTipService.ToolTip="Back to the default key" />
                    </StackPanel>
                    <TextBlock x:Name="KeyEditorNote" Style="{StaticResource SettingNote}" />
                  </StackPanel>
                </Border>
                <TextBox x:Name="KeyFilterBox" PlaceholderText="Filter the list" TextChanged="OnKeyFilterChanged" MaxWidth="360" HorizontalAlignment="Left"
                         AutomationProperties.Name="Filter the shortcuts" />
                <ListView x:Name="KeyList" SelectionMode="Single" ItemTemplate="{StaticResource KeyRowTemplate}" SelectionChanged="OnKeyRowSelected" />
              </StackPanel>

              <!-- Pages that only say what they will hold -->
              <StackPanel x:Name="PlannedPage" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="PlannedTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PlannedWhen" Style="{StaticResource SettingNote}" />
                <ItemsControl x:Name="PlannedList" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
