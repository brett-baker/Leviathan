<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.PaneNavBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leviathan.App">

  <!-- Back, forward, up, reload and the address bar of ONE pane (spec 4, 5, 15.1). Every pane of a split tab has its own, bound to that pane for good. -->
  <Grid x:Name="Row" Padding="8,0,8,6" SizeChanged="OnRowSizeChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Button x:Name="BackButton" Grid.Column="0" Margin="0,0,4,0" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
      <FontIcon Glyph="&#xE72B;" FontSize="14" />
    </Button>
    <Button x:Name="ForwardButton" Grid.Column="1" Margin="0,0,4,0" ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
      <FontIcon Glyph="&#xE72A;" FontSize="14" />
    </Button>
    <Button x:Name="UpButton" Grid.Column="2" Margin="0,0,4,0" ToolTipService.ToolTip="Up (Alt+Up)" AutomationProperties.Name="Up">
      <FontIcon Glyph="&#xE74A;" FontSize="14" />
    </Button>
    <Button x:Name="ReloadButton" Grid.Column="3" Margin="0,0,4,0" ToolTipService.ToolTip="Reload (F5)" AutomationProperties.Name="Reload">
      <FontIcon Glyph="&#xE72C;" FontSize="14" />
    </Button>

    <local:AddressBar x:Name="Address" Grid.Column="4" VerticalAlignment="Center" />
  </Grid>
</UserControl>
