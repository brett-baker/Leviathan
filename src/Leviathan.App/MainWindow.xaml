<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Leviathan.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leviathan.App"
    xmlns:model="using:Leviathan.Core.Model">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Row 0: tab strip in the title bar (spec 4). Only the strip is shown; the selected tab's content is the body below. -->
    <TabView x:Name="TabsView"
             Grid.Row="0"
             IsAddTabButtonVisible="True"
             CanReorderTabs="False"
             CanDragTabs="False"
             TabWidthMode="Equal"
             AddTabButtonClick="OnAddTabClick"
             TabCloseRequested="OnTabCloseRequested"
             SelectionChanged="OnTabSelectionChanged">
      <TabView.TabStripFooter>
        <Grid x:Name="DragRegion" MinWidth="140" />
      </TabView.TabStripFooter>
    </TabView>

    <!-- Row 1: navigation row (spec 4, 5). -->
    <Grid Grid.Row="1" Padding="8,4,8,6" ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton" Grid.Column="0" Click="OnBackClick" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
        <FontIcon Glyph="&#xE72B;" FontSize="14" />
      </Button>
      <Button x:Name="ForwardButton" Grid.Column="1" Click="OnForwardClick" ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
        <FontIcon Glyph="&#xE72A;" FontSize="14" />
      </Button>
      <Button x:Name="UpButton" Grid.Column="2" Click="OnUpClick" ToolTipService.ToolTip="Up (Alt+Up)" AutomationProperties.Name="Up">
        <FontIcon Glyph="&#xE74A;" FontSize="14" />
      </Button>
      <Button x:Name="ReloadButton" Grid.Column="3" Click="OnReloadClick" ToolTipService.ToolTip="Reload (F5)" AutomationProperties.Name="Reload">
        <FontIcon Glyph="&#xE72C;" FontSize="14" />
      </Button>

      <!-- A plain text box for now; the breadcrumb address bar replaces it in slice D3. -->
      <TextBox x:Name="AddressBox"
               Grid.Column="4"
               PlaceholderText="Type a path, \\server\share, sftp://host or shell:Downloads"
               AutomationProperties.Name="Address"
               GotFocus="OnAddressGotFocus"
               KeyDown="OnAddressKeyDown" />

      <AutoSuggestBox x:Name="SearchBox" Grid.Column="5" PlaceholderText="Search (Phase 4)" IsEnabled="False" QueryIcon="Find" />

      <Button x:Name="OptionsButton" Grid.Column="6" ToolTipService.ToolTip="Options" AutomationProperties.Name="Options">
        <FontIcon Glyph="&#xE713;" FontSize="14" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="New window" Click="OnNewWindowClick" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Diagnostics…" Click="OnDiagnosticsClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Row 2: sidebar | file view | preview pane (spec 4). -->
    <Grid Grid.Row="2" ColumnSpacing="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <!-- Placeholder list of common folders and drives; the virtualized tree replaces it in slice D6. -->
      <ListView x:Name="Sidebar"
                Grid.Column="0"
                IsItemClickEnabled="True"
                SelectionMode="None"
                ItemClick="OnSidebarItemClick"
                Padding="4,0">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:SidebarItem">
            <Grid ColumnSpacing="10" Padding="4,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind local:Formatters.VisibleWhenNotEmpty(Detail)}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- The file view. A plain virtualized list for now; the column grid replaces it in slice D4. -->
      <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="12,6" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Grid.Column="2" Text="Size" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Grid.Column="3" Text="Date modified" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
        <ListView x:Name="FileList"
                  Grid.Row="1"
                  SelectionMode="Extended"
                  SelectionChanged="OnFileSelectionChanged"
                  DoubleTapped="OnFileDoubleTapped"
                  KeyDown="OnFileKeyDown">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="MinHeight" Value="30" />
              <Setter Property="Padding" Value="12,0" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="model:FileEntry">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind local:Formatters.Glyph(Kind, Attributes)}" FontSize="16" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind local:Formatters.SizeText(Kind, Size)}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{x:Bind local:Formatters.DateText(Modified)}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Loading, empty and error states (spec 8.6); the skeleton rows and the Retry banner come with slice D4. -->
        <StackPanel x:Name="StatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
          <ProgressRing x:Name="StateRing" IsActive="False" Width="28" Height="28" />
          <TextBlock x:Name="StateTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock x:Name="StateDetail" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>

      <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Preview and details" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Text="Video preview, metadata and tags arrive in Phase 3." TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Row 3: status bar (spec 16). -->
    <Grid Grid.Row="3" Padding="12,4" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      <TextBlock x:Name="MessageText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="StallText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
  </Grid>
</Window>
