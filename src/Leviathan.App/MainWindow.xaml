<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Leviathan.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leviathan.App"
    xmlns:sidebar="using:Leviathan.ViewModels.Sidebar"
    xmlns:model="using:Leviathan.Core.Model">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Row 0: tab strip in the title bar (spec 4). Only the strip is shown; the selected tab's content is the body below. -->
    <TabView x:Name="TabsView"
             Grid.Row="0"
             IsAddTabButtonVisible="True"
             CanReorderTabs="True"
             CanDragTabs="True"
             AllowDropTabs="True"
             TabWidthMode="SizeToContent"
             AddTabButtonClick="OnAddTabClick"
             TabCloseRequested="OnTabCloseRequested"
             SelectionChanged="OnTabSelectionChanged"
             TabDragStarting="OnTabDragStarting"
             TabDragCompleted="OnTabDragCompleted"
             TabDroppedOutside="OnTabDroppedOutside"
             TabStripDragOver="OnTabStripDragOver"
             TabStripDrop="OnTabStripDrop"
             TabItemsChanged="OnTabItemsChanged">
      <TabView.TabStripFooter>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AllTabsButton" Width="32" Height="28" Padding="0" Margin="2,0"
                  Click="OnAllTabsClick" ToolTipService.ToolTip="All tabs" AutomationProperties.Name="All tabs"
                  Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0">
            <FontIcon Glyph="&#xE70D;" FontSize="12" />
          </Button>
          <Grid x:Name="DragRegion" MinWidth="140" />
        </StackPanel>
      </TabView.TabStripFooter>
    </TabView>

    <!-- Row 1: navigation row (spec 4, 5). -->
    <Grid Grid.Row="1" Padding="8,4,8,6" ColumnSpacing="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton" Grid.Column="0" Click="OnBackClick" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
        <FontIcon Glyph="&#xE72B;" FontSize="14" />
      </Button>
      <Button x:Name="ForwardButton" Grid.Column="1" Click="OnForwardClick" ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
        <FontIcon Glyph="&#xE72A;" FontSize="14" />
      </Button>
      <Button x:Name="UpButton" Grid.Column="2" Click="OnUpClick" ToolTipService.ToolTip="Up (Alt+Up)" AutomationProperties.Name="Up">
        <FontIcon Glyph="&#xE74A;" FontSize="14" />
      </Button>
      <Button x:Name="ReloadButton" Grid.Column="3" Click="OnReloadClick" ToolTipService.ToolTip="Reload (F5)" AutomationProperties.Name="Reload">
        <FontIcon Glyph="&#xE72C;" FontSize="14" />
      </Button>

      <local:AddressBar x:Name="Address" Grid.Column="4" VerticalAlignment="Center" />

      <!-- Panes (spec 6.3, 15.1): one pane, two side by side, two stacked; and the preview pane. -->
      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="4,0">
        <ToggleButton x:Name="PaneSingleButton" IsChecked="True" Padding="6,5" ToolTipService.ToolTip="One pane" AutomationProperties.Name="One pane" Click="OnPaneSingleClick">
          <Border Width="16" Height="12" BorderThickness="1.5" CornerRadius="2" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
        </ToggleButton>
        <ToggleButton x:Name="PaneSideButton" Padding="6,5" Click="OnPaneSideClick" ToolTipService.ToolTip="Split side by side (Ctrl+\)" AutomationProperties.Name="Split side by side">
          <Grid Width="16" Height="12">
            <Border BorderThickness="1.5" CornerRadius="2" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
            <Border Width="1.5" HorizontalAlignment="Center" Background="{ThemeResource TextFillColorPrimaryBrush}" />
          </Grid>
        </ToggleButton>
        <ToggleButton x:Name="PaneStackedButton" Padding="6,5" Click="OnPaneStackedClick" ToolTipService.ToolTip="Split top and bottom (Ctrl+Shift+\)" AutomationProperties.Name="Split top and bottom">
          <Grid Width="16" Height="12">
            <Border BorderThickness="1.5" CornerRadius="2" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
            <Border Height="1.5" VerticalAlignment="Center" Background="{ThemeResource TextFillColorPrimaryBrush}" />
          </Grid>
        </ToggleButton>
        <ToggleButton x:Name="PreviewToggle" IsChecked="True" Padding="6,5" Click="OnPreviewToggleClick" ToolTipService.ToolTip="Preview pane (Alt+P)" AutomationProperties.Name="Preview pane">
          <Grid Width="16" Height="12">
            <Border BorderThickness="1.5" CornerRadius="2" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
            <Border Width="5" HorizontalAlignment="Right" Margin="0,1.5,1.5,1.5" Background="{ThemeResource TextFillColorPrimaryBrush}" />
          </Grid>
        </ToggleButton>
      </StackPanel>

      <AutoSuggestBox x:Name="SearchBox" Grid.Column="6" PlaceholderText="Search (Phase 4)" IsEnabled="False" QueryIcon="Find" />
    </Grid>

    <!-- Row 2: the activity strip (spec 12.6): thin progress lines of the running jobs; no height when nothing runs. -->
    <local:ActivityStrip x:Name="Strip" Grid.Row="2" />

    <!-- Row 3: command bar (spec 6): New and the clipboard group, context actions that follow the selection, then view controls. -->
    <Grid Grid.Row="3" Padding="8,0,8,4" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <CommandBar x:Name="Bar" Grid.Column="0" HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Collapsed"
                  IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto">
        <AppBarElementContainer VerticalContentAlignment="Center">
          <DropDownButton x:Name="NewButton" AutomationProperties.Name="New" ToolTipService.ToolTip="New (Ctrl+Shift+N creates a folder)">
            <StackPanel x:Name="NewContent" Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="14" />
              <TextBlock Text="New" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout x:Name="NewMenu" Opening="OnNewMenuOpening" />
            </DropDownButton.Flyout>
          </DropDownButton>
        </AppBarElementContainer>
        <AppBarSeparator />
        <AppBarButton x:Name="CutButton" Label="Cut" Icon="Cut" Click="OnBarButtonClick" />
        <AppBarButton x:Name="CopyButton" Label="Copy" Icon="Copy" Click="OnBarButtonClick" />
        <AppBarElementContainer VerticalContentAlignment="Center">
          <SplitButton x:Name="PasteButton" AutomationProperties.Name="Paste" Padding="10,6" Background="Transparent" BorderThickness="0" Click="OnPasteClick">
            <FontIcon Glyph="&#xE77F;" FontSize="16" />
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Paste as shortcut" IsEnabled="False" ToolTipService.ToolTip="Shortcuts, hard links and symbolic links arrive in Phase 2" />
                <MenuFlyoutItem Text="Paste as hard link" IsEnabled="False" ToolTipService.ToolTip="Shortcuts, hard links and symbolic links arrive in Phase 2" />
                <MenuFlyoutItem Text="Paste as symbolic link" IsEnabled="False" ToolTipService.ToolTip="Shortcuts, hard links and symbolic links arrive in Phase 2" />
                <MenuFlyoutItem x:Name="PasteIntoNewFolderItem" Text="Paste into new folder" Click="OnPasteIntoNewFolderClick" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </AppBarElementContainer>
        <AppBarButton x:Name="RenameButton" Label="Rename" Icon="Rename" Click="OnBarButtonClick" />
        <AppBarButton x:Name="DeleteButton" Label="Delete" Icon="Delete" Click="OnBarButtonClick" />
        <AppBarButton x:Name="UndoButton" Label="Undo" Icon="Undo" Click="OnBarButtonClick" />
        <AppBarButton x:Name="RedoButton" Label="Redo" Icon="Redo" Click="OnBarButtonClick" />
        <AppBarSeparator x:Name="ContextSeparator" />
      </CommandBar>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <DropDownButton x:Name="ViewButton" AutomationProperties.Name="View" ToolTipService.ToolTip="View">
          <FontIcon Glyph="&#xE8A9;" FontSize="14" />
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="ViewMenu" Opening="OnViewMenuOpening" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <DropDownButton x:Name="SortButton" AutomationProperties.Name="Sort" ToolTipService.ToolTip="Sort">
          <FontIcon Glyph="&#xE8CB;" FontSize="14" />
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="SortMenu" Opening="OnSortMenuOpening" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <DropDownButton x:Name="GroupButton" AutomationProperties.Name="Group" ToolTipService.ToolTip="Group">
          <FontIcon Glyph="&#xF168;" FontSize="14" />
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="GroupMenu" Opening="OnGroupMenuOpening" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBox x:Name="FilterBox" Width="170" PlaceholderText="Filter this folder" AutomationProperties.Name="Filter this folder"
                 ToolTipService.ToolTip="Filters as you type: *.mp4, size:&gt;1GB, tag:red, duration:&lt;2m (Ctrl+Shift+F)"
                 TextChanged="OnFilterTextChanged" KeyDown="OnFilterKeyDown" />
        <SplitButton x:Name="OptionsButton" ToolTipService.ToolTip="Settings (Ctrl+,). The arrow has windows, profiles and diagnostics." AutomationProperties.Name="Settings"
                     Click="OnOptionsClick" Padding="8,4">
          <FontIcon Glyph="&#xE713;" FontSize="14" />
          <SplitButton.Flyout>
            <MenuFlyout Opening="OnOptionsMenuOpening">
              <MenuFlyoutItem Text="New window" Click="OnNewWindowClick" />
              <MenuFlyoutSubItem x:Name="ProfilesMenu" Text="Profiles" />
              <MenuFlyoutSubItem x:Name="StartupMenu" Text="At startup" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Settings…" Click="OnOptionsClick" KeyboardAcceleratorTextOverride="Ctrl+," />
              <MenuFlyoutItem Text="Operations queue" Click="OnHubOperationsMenuClick" />
              <MenuFlyoutItem Text="Soft-delete bin" Click="OnHubBinClick" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Diagnostics…" Click="OnDiagnosticsClick" />
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
      </StackPanel>
    </Grid>

    <!-- Row 4: sidebar | file view | preview pane (spec 4). -->
    <Grid x:Name="BodyArea" Grid.Row="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid x:Name="BodyContent" ColumnSpacing="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="PreviewColumn" Width="340" />
      </Grid.ColumnDefinitions>

      <!-- Splitter between the tree and the file view (spec 4): drag, double-click, arrow keys. -->
      <local:SidebarSplitter x:Name="SidebarGrip" Grid.Column="1" />

      <!-- The sidebar tree (spec 7): one virtualized list of rows; the tree model decides which rows exist. -->
      <ListView x:Name="Sidebar"
                Grid.Column="0"
                IsItemClickEnabled="True"
                SelectionMode="None"
                ItemClick="OnSidebarItemClick"
                PointerPressed="OnSidebarPointerPressed"
                RightTapped="OnSidebarRightTapped"
                KeyDown="OnSidebarKeyDown"
                Padding="4,0">
        <!-- No add / remove / reposition animations: expanding a folder with hundreds of subfolders must not animate them all. -->
        <ListView.ItemContainerTransitions>
          <TransitionCollection />
        </ListView.ItemContainerTransitions>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="sidebar:SidebarNode">
            <Grid Background="{x:Bind local:SidebarFormat.Background(IsSelected), Mode=OneWay}" CornerRadius="4" Padding="{x:Bind local:SidebarFormat.RowPadding()}"
                  BorderThickness="1" BorderBrush="Transparent"
                  AllowDrop="True" DragOver="OnSidebarDragOver" DragLeave="OnSidebarDragLeave" Drop="OnSidebarDrop"
                  ToolTipService.ToolTip="{x:Bind Detail}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="{x:Bind local:SidebarFormat.IndentWidth(Depth)}" />
              <Button Grid.Column="1" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                      Click="OnSidebarChevronClick" Tag="{x:Bind}"
                      Visibility="{x:Bind local:SidebarFormat.Visible(CanExpand), Mode=OneWay}"
                      AutomationProperties.Name="Expand or collapse">
                <ContentControl IsTabStop="False" Content="{x:Bind local:SidebarFormat.ChevronOf(IsExpanded), Mode=OneWay}" />
              </Button>
              <ContentControl Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" IsTabStop="False"
                              Content="{x:Bind local:SidebarFormat.IconOf(Icon, Glyph, Accent)}"
                              Visibility="{x:Bind local:SidebarFormat.HasIcon(Kind, Glyph)}" />
              <Ellipse Grid.Column="2" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                       Fill="{x:Bind local:SidebarFormat.HealthBrush(Health), Mode=OneWay}"
                       Visibility="{x:Bind local:SidebarFormat.HasHealth(Health), Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind local:SidebarFormat.HealthText(Health), Mode=OneWay}" />
              <ProgressRing Grid.Column="2" Width="14" Height="14" IsActive="True" HorizontalAlignment="Center"
                            Visibility="{x:Bind local:SidebarFormat.IsLoading(Kind)}" />
              <StackPanel Grid.Column="3" Margin="6,0,0,0" Spacing="2">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                           FontWeight="{x:Bind local:SidebarFormat.Weight(Kind)}"
                           Foreground="{x:Bind local:SidebarFormat.Foreground(Kind)}" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind local:SidebarFormat.HasDetail(Kind, Detail)}" />
                <ProgressBar Maximum="100" Height="3" Value="{x:Bind local:SidebarFormat.Percent(UsedFraction)}"
                             Foreground="{x:Bind local:SidebarFormat.BarBrush(IsLowOnSpace)}"
                             Visibility="{x:Bind local:SidebarFormat.HasBar(UsedFraction)}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- The file view (spec 8): the Details grid with its states laid over the rows (spec 8.6). -->
      <Grid Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A share that does not answer (spec 3.3, 8.6): its last saved listing is shown greyed under this banner. -->
        <InfoBar x:Name="OfflineBar" Grid.Row="0" Severity="Warning" IsOpen="False" IsClosable="False" Margin="8,8,8,0">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="OfflineRetryButton" Content="Retry" Click="OnOfflineRetryClick" />
            <Button x:Name="OfflineToggleButton" Content="Work offline" Click="OnOfflineToggleClick" />
          </StackPanel>
        </InfoBar>

        <!-- The panes of the tab (spec 15.1): the first pane always, the second while the tab is split. The gap between them is 6 px. -->
        <Grid x:Name="PaneHost" Grid.Row="2">
        <Grid x:Name="Pane1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:PaneHeader x:Name="Header1" />
        <Grid x:Name="Pane1Body" Grid.Row="1">
        <local:DetailsGrid x:Name="FileList" />
        <local:FlowView x:Name="FlowList" Visibility="Collapsed" />

        <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,40,0,0" Visibility="Collapsed">
          <ProgressRing x:Name="StateRing" IsActive="False" Width="28" Height="28" />
          <ContentControl x:Name="StateIcon" HorizontalAlignment="Center" IsTabStop="False" />
          <TextBlock x:Name="StateTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock x:Name="StateDetail" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Button x:Name="RetryButton" Content="Try again" HorizontalAlignment="Center" Click="OnRetryClick" Visibility="Collapsed" />
          <Button x:Name="SignInButton" Content="Sign in…" HorizontalAlignment="Center" Click="OnSignInClick" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        </Grid>
        <Border x:Name="Pane1Frame" Grid.RowSpan="2" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" BorderBrush="Transparent" />
        </Grid>

        <Border x:Name="PaneGap" Visibility="Collapsed" />

        <Grid x:Name="Pane2" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <local:PaneHeader x:Name="Header2" />
          <Grid x:Name="Pane2Body" Grid.Row="1">
          <local:DetailsGrid x:Name="FileList2" />
          <local:FlowView x:Name="FlowList2" Visibility="Collapsed" />
          <StackPanel x:Name="StatePanel2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,40,0,0" Visibility="Collapsed">
            <TextBlock x:Name="State2Title" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="State2Detail" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="Retry2Button" Content="Try again" HorizontalAlignment="Center" Click="OnRetry2Click" Visibility="Collapsed" />
          </StackPanel>
          </Grid>
          <Border x:Name="Pane2Frame" Grid.RowSpan="2" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" BorderBrush="Transparent" />
        </Grid>
        </Grid>
      </Grid>

      <!-- Splitter on the left edge of the preview pane (spec 9): drag to resize, double-click to hide. -->
      <local:SidebarSplitter x:Name="PreviewGrip" Grid.Column="3" />

      <!-- The preview and details pane (spec 9): the preview part on top, the details part below; either can be collapsed. -->
      <Border x:Name="PreviewPane" Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
        <Grid RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewTitle" Text="Preview and details" Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <ToggleButton x:Name="VideoSmallButton" Content="S" Padding="8,2" MinWidth="0" Click="OnVideoSmallClick"
                            ToolTipService.ToolTip="Small video" AutomationProperties.Name="Small video" />
              <ToggleButton x:Name="VideoMediumButton" Content="M" Padding="8,2" MinWidth="0" Click="OnVideoMediumClick"
                            ToolTipService.ToolTip="Medium video" AutomationProperties.Name="Medium video" />
              <ToggleButton x:Name="VideoLargeButton" Content="L" Padding="8,2" MinWidth="0" Click="OnVideoLargeClick"
                            ToolTipService.ToolTip="Large video (fills the pane width)" AutomationProperties.Name="Large video" />
            </StackPanel>
            <Button Grid.Column="2" Padding="6,2" Background="Transparent" BorderThickness="0" Click="OnPreviewToggleClick"
                    ToolTipService.ToolTip="Hide the preview pane (Alt+P)" AutomationProperties.Name="Hide preview pane">
              <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="4">
            <Button x:Name="PreviewSectionButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2"
                    Background="Transparent" BorderThickness="0" Click="OnPreviewSectionClick" AutomationProperties.Name="Preview section">
              <TextBlock x:Name="PreviewSectionLabel" Text="▾ Preview" Style="{StaticResource CaptionTextBlockStyle}" />
            </Button>
            <StackPanel x:Name="PreviewBody" Spacing="0">
              <Border x:Name="VideoArea" Height="130" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                <Grid x:Name="VideoHost">
                  <TextBlock x:Name="VideoPlaceholder" Margin="12" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </Border>
              <!-- Drag this to make the video taller or shorter (spec 9). -->
              <local:ResizeHandle x:Name="VideoHandle" Height="10" Background="Transparent" AutomationProperties.Name="Resize video"
                      ToolTipService.ToolTip="Drag to make the video taller or shorter">
                <Border Height="3" Width="36" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
              </local:ResizeHandle>
              <!-- The playback controls, shown while a video or audio file is previewed (spec 9). -->
              <local:PlaybackBar x:Name="PreviewBar" Margin="0,2,0,0" Visibility="Collapsed" />
              <!-- Spec 15.1: with two panes, the selection can be sent to the other pane from here, right under the video. -->
              <StackPanel x:Name="PreviewActions" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" Visibility="Collapsed">
                <Button x:Name="PreviewMoveButton" Content="Move (F6)" Click="OnPreviewMoveClick" />
                <Button x:Name="PreviewCopyButton" Content="Copy (F5)" Click="OnPreviewCopyClick" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="DetailsSectionButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2"
                    Background="Transparent" BorderThickness="0" Click="OnDetailsSectionClick" AutomationProperties.Name="Details section">
              <TextBlock x:Name="DetailsSectionLabel" Text="▾ Details" Style="{StaticResource CaptionTextBlockStyle}" />
            </Button>
            <ScrollViewer x:Name="DetailsBody" Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="4">
                <TextBlock x:Name="PreviewName" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewSize" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DetailsHint" Text="Select one item to see its details." TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="DetailsSections" Spacing="4" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </Grid>

    <!-- Row 5: status bar (spec 16). -->
    <!-- Parts with nothing to say are collapsed; clicking a part acts on it. -->
    <Grid x:Name="StatusBar" Grid.Row="5" Padding="8,2" ColumnSpacing="4">
      <Grid.Resources>
        <Style x:Key="StatusPart" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="6,2" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="MinWidth" Value="0" />
        </Style>
      </Grid.Resources>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="ItemsPart" Style="{StaticResource StatusPart}" Click="OnStatusItemsClick" ToolTipService.ToolTip="Show or hide hidden items">
        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" />
      </Button>
      <Button x:Name="SelectionPart" Grid.Column="1" Style="{StaticResource StatusPart}" Click="OnStatusSelectionClick" ToolTipService.ToolTip="Select none" Visibility="Collapsed">
        <TextBlock x:Name="SelectionText" Style="{StaticResource CaptionTextBlockStyle}" />
      </Button>
      <Button x:Name="FilterPart" Grid.Column="2" Style="{StaticResource StatusPart}" Click="OnStatusFilterClick" ToolTipService.ToolTip="Clear the filter" Visibility="Collapsed">
        <TextBlock x:Name="FilterText" Style="{StaticResource CaptionTextBlockStyle}" />
      </Button>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="HealthText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

        <!-- Rows that came from the cache: shown while the real folder is checked, so it is clear they may still change (spec 3.3). -->
        <StackPanel x:Name="NoticePart" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Polite">
          <ProgressRing x:Name="NoticeRing" Width="12" Height="12" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
          <ContentControl x:Name="NoticeIcon" Visibility="Collapsed" VerticalAlignment="Center" IsTabStop="False" />
          <TextBlock x:Name="NoticeText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="MessageText" Grid.Column="4" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      <StackPanel x:Name="FreePart" Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed"
                  Tapped="OnFreeSpaceTapped" ToolTipService.ToolTip="Space map of this folder (Ctrl+Shift+O)">
        <TextBlock x:Name="FreeText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ProgressBar x:Name="FreeBar" Width="80" Height="4" Maximum="100" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- A job failed and nobody has looked yet: the full text is in the Operations tab, this shows the start of it on hover. -->
        <Button x:Name="FailurePart" Style="{StaticResource StatusPart}" Visibility="Collapsed" Click="OnHubOperationsClick" AutomationProperties.Name="A job failed">
          <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </Button>
        <!-- The jobs running now ("2 jobs, 1 queued, 112 MB/s, 2 min left"); opens the Operations tab of the status hub (spec 16.1). -->
        <Button x:Name="OperationsPart" Style="{StaticResource StatusPart}" Visibility="Collapsed" Click="OnHubOperationsClick"
                ToolTipService.ToolTip="Show the operations (Ctrl+Shift+O)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ProgressRing Width="12" Height="12" IsActive="True" />
            <TextBlock x:Name="OperationsText" Style="{StaticResource CaptionTextBlockStyle}" />
            <local:SparklineView x:Name="OperationsSparkline" Width="48" Height="14" VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="StallText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Slider x:Name="SizeSlider" Width="90" Minimum="64" Maximum="512" StepFrequency="16" SmallChange="16" LargeChange="64" Visibility="Collapsed"
                VerticalAlignment="Center" ValueChanged="OnSizeSliderChanged" AutomationProperties.Name="Thumbnail size" />
        <Button x:Name="DetailsSwitch" Style="{StaticResource StatusPart}" Click="OnLayoutSwitchClick" Tag="details" ToolTipService.ToolTip="Details (Ctrl+Shift+6)" AutomationProperties.Name="Details">
          <FontIcon Glyph="&#xE8FD;" FontSize="14" />
        </Button>
        <Button x:Name="ListSwitch" Style="{StaticResource StatusPart}" Click="OnLayoutSwitchClick" Tag="list" ToolTipService.ToolTip="List (Ctrl+Shift+5)" AutomationProperties.Name="List">
          <FontIcon Glyph="&#xE8A9;" FontSize="14" />
        </Button>
        <Button x:Name="ThumbsSwitch" Style="{StaticResource StatusPart}" Click="OnLayoutSwitchClick" Tag="thumbnails" ToolTipService.ToolTip="Thumbnails (Ctrl+Shift+2)" AutomationProperties.Name="Thumbnails">
          <FontIcon Glyph="&#xE80A;" FontSize="14" />
        </Button>
      </StackPanel>
      <!-- The status hub (spec 16.1): the chevron opens it; the badge counts failed jobs nobody has looked at. -->
      <Grid Grid.Column="8" VerticalAlignment="Center">
        <Button x:Name="HubChevron" Style="{StaticResource StatusPart}" Click="OnHubChevronClick" AutomationProperties.Name="Status hub"
                ToolTipService.ToolTip="Operations, activity, background tasks and quick settings (Ctrl+Shift+O)" />
        <InfoBadge x:Name="HubBadge" Value="0" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />
      </Grid>
    </Grid>

    <!-- The settings sheet (spec 17.2, D36) rises over the window from the bottom; the sheet itself is made the first time it is opened. -->
    <Grid x:Name="SettingsLayer" Grid.Row="1" Grid.RowSpan="5" Visibility="Collapsed">
      <Border x:Name="SettingsScrim" Background="#66000000" Tapped="OnSettingsScrimTapped" />
    </Grid>
  </Grid>
</Window>
