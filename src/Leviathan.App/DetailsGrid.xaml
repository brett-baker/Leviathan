<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.DetailsGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    AutomationProperties.Name="Files">

  <!-- Spec 8.2: a header with sortable, resizable, reorderable columns over a virtualized list of fixed-height rows. -->
  <Grid x:Name="Frame" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="HeaderScroll"
                  HorizontalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Disabled"
                  ZoomMode="Disabled">
      <Grid>
        <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" Height="32" Margin="4,0,0,0" Background="Transparent" RightTapped="OnHeaderRightTapped" />
        <Canvas x:Name="HeaderOverlay" Margin="4,0,0,0" IsHitTestVisible="False">
          <Rectangle x:Name="DropMarker" Width="2" Height="32" Visibility="Collapsed" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Canvas>
      </Grid>
    </ScrollViewer>
    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

    <ScrollViewer x:Name="Scroller"
                  Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Auto"
                  ZoomMode="Disabled"
                  ViewChanged="OnScrollerViewChanged"
                  SizeChanged="OnScrollerSizeChanged"
                  PointerPressed="OnBodyPointerPressed"
                  DoubleTapped="OnBodyDoubleTapped"
                  RightTapped="OnBodyRightTapped">
      <muxc:ItemsRepeater x:Name="Repeater" Margin="4,2,4,2">
        <muxc:ItemsRepeater.Layout>
          <muxc:StackLayout Orientation="Vertical" Spacing="0" />
        </muxc:ItemsRepeater.Layout>
      </muxc:ItemsRepeater>
    </ScrollViewer>

    <!-- The rubber band (spec 8.4), drawn over the rows in viewport coordinates. -->
    <Canvas x:Name="BandLayer" Grid.Row="1" IsHitTestVisible="False">
      <Rectangle x:Name="Band" Visibility="Collapsed" StrokeThickness="1" RadiusX="2" RadiusY="2"
                 Stroke="{ThemeResource AccentFillColorDefaultBrush}" Fill="{ThemeResource AccentFillColorSecondaryBrush}" Opacity="0.55" />
    </Canvas>

    <!-- Shown instead of rows while the first rows of a folder are on their way (spec 8.6). -->
    <StackPanel x:Name="Skeleton" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False" Margin="12,6,12,0" Spacing="0" />
  </Grid>
</UserControl>
