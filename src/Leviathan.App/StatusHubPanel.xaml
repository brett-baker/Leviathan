<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.StatusHubPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leviathan.App"
    xmlns:hub="using:Leviathan.ViewModels.Hub"
    xmlns:activity="using:Leviathan.ViewModels.Activity">

  <UserControl.Resources>
    <DataTemplate x:Key="OperationRowTemplate" x:DataType="hub:OperationRow">
      <Grid ColumnSpacing="10" Padding="4,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="4" CornerRadius="2" Background="{x:Bind local:HubFormat.Color(Entry.ColorIndex), Mode=OneWay}" />
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="{x:Bind Entry.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
          <ProgressBar Value="{x:Bind local:HubFormat.Value(Entry.Percent), Mode=OneWay}" Maximum="100"
                       IsIndeterminate="{x:Bind local:HubFormat.Indeterminate(Entry.Percent, Entry.State), Mode=OneWay}"
                       ShowError="{x:Bind Entry.IsFailed, Mode=OneWay}"
                       Visibility="{x:Bind local:HubFormat.ShowBar(Entry.IsActive), Mode=OneWay}" />
          <TextBlock Text="{x:Bind Entry.Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <!-- The job stopped on an error it cannot decide for itself (spec 12.2): Skip / Retry / Skip all like this. -->
          <StackPanel Spacing="4" Visibility="{x:Bind local:HubFormat.ShowBar(Entry.HasPrompt), Mode=OneWay}">
            <TextBlock Text="{x:Bind Entry.PromptText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Skip" Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnPromptSkipClick" Padding="10,3" MinHeight="0" />
              <Button Content="Retry" Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnPromptRetryClick" Padding="10,3" MinHeight="0" />
              <Button Content="Skip all like this" Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnPromptSkipAllClick" Padding="10,3" MinHeight="0" />
            </StackPanel>
          </StackPanel>
          <!-- The job found files that already exist (spec 12.4): one dialog for the whole job. -->
          <Button Content="Resolve conflicts…" Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnResolveConflictsClick" Padding="10,3" MinHeight="0"
                  HorizontalAlignment="Left" Visibility="{x:Bind local:HubFormat.ShowBar(Entry.HasConflicts), Mode=OneWay}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right">
          <TextBlock Text="{x:Bind local:HubFormat.StateText(Entry.State), Mode=OneWay}" HorizontalAlignment="Right"
                     Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <local:SparklineView Values="{x:Bind Entry.Speeds, Mode=OneWay}" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
          <Button Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnRetryFailedClick" Padding="6,2" MinHeight="0" MinWidth="0"
                  Visibility="{x:Bind local:HubFormat.ShowBar(Entry.CanRetryFailed), Mode=OneWay}" ToolTipService.ToolTip="Run the items that failed again" AutomationProperties.Name="Retry failed">
            <FontIcon Glyph="&#xE72C;" FontSize="12" />
          </Button>
          <Button Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnReportClick" Padding="6,2" MinHeight="0" MinWidth="0"
                  Visibility="{x:Bind local:HubFormat.ShowBar(Entry.HasReport), Mode=OneWay}" ToolTipService.ToolTip="Show what happened to each item" AutomationProperties.Name="Show report">
            <FontIcon Glyph="&#xE9D9;" FontSize="12" />
          </Button>
          <Button Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnPauseJobClick" Padding="6,2" MinHeight="0" MinWidth="0"
                  Visibility="{x:Bind local:HubFormat.ShowBar(Entry.CanPause), Mode=OneWay}" ToolTipService.ToolTip="Pause this job" AutomationProperties.Name="Pause job">
            <FontIcon Glyph="&#xE769;" FontSize="12" />
          </Button>
          <Button Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnResumeJobClick" Padding="6,2" MinHeight="0" MinWidth="0"
                  Visibility="{x:Bind local:HubFormat.ShowBar(Entry.CanResume), Mode=OneWay}" ToolTipService.ToolTip="Resume this job" AutomationProperties.Name="Resume job">
            <FontIcon Glyph="&#xE768;" FontSize="12" />
          </Button>
          <!-- Cancel a queued or running job; take a finished one off the list (spec 12.6: row actions). -->
          <Button Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnCancelJobClick" Padding="6,2" MinHeight="0" MinWidth="0"
                  Visibility="{x:Bind local:HubFormat.ShowBar(Entry.CanCancel), Mode=OneWay}" ToolTipService.ToolTip="Cancel this job" AutomationProperties.Name="Cancel job">
            <FontIcon Glyph="&#xE711;" FontSize="12" />
          </Button>
          <Button Tag="{x:Bind Entry.Id, Mode=OneWay}" Click="OnRemoveJobClick" Padding="6,2" MinHeight="0" MinWidth="0"
                  Visibility="{x:Bind local:HubFormat.ShowBar(Entry.HasReport), Mode=OneWay}" ToolTipService.ToolTip="Remove from the list" AutomationProperties.Name="Remove job">
            <FontIcon Glyph="&#xE74D;" FontSize="12" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OperationHeaderTemplate" x:DataType="hub:OperationHeader">
      <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,10,0,2" />
    </DataTemplate>

    <local:OperationTemplateSelector x:Key="OperationSelector" Row="{StaticResource OperationRowTemplate}" Header="{StaticResource OperationHeaderTemplate}" />


    <DataTemplate x:Key="ActivityTemplate" x:DataType="activity:ActivityEntry">
      <Grid ColumnSpacing="12" Padding="4,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="104" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind local:HubFormat.When(Time)}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Top" Margin="0,2,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis"
                     Foreground="{x:Bind local:HubFormat.ActivityBrush(IsError)}" />
          <TextBlock Text="{x:Bind local:HubFormat.Where(Target, Location)}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind local:HubFormat.ShowText(Target, Location)}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BinTemplate" x:DataType="hub:BinRow">
      <Grid ColumnSpacing="12" Padding="4,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="1">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Where}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Deleted from this folder" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="1">
          <TextBlock Text="{x:Bind Deleted}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
          <TextBlock Text="{x:Bind Size}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProcessTemplate" x:DataType="hub:ProcessEntry">
      <Grid ColumnSpacing="12" Padding="4,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock Text="{x:Bind local:HubFormat.ProcessLine(State, ProcessId, Restarts)}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Button Grid.Column="2" Content="Switch back on" Tag="{x:Bind Name}" Click="OnReenableClick" VerticalAlignment="Center"
                Visibility="{x:Bind local:HubFormat.ShowBar(CanReenable)}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="QuarantineTemplate" x:DataType="hub:QuarantinedFile">
      <Grid ColumnSpacing="12" Padding="4,4" ToolTipService.ToolTip="{x:Bind Path}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="1">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Retry this file" Tag="{x:Bind Path}" Click="OnRetryMediaClick" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TaskTemplate" x:DataType="hub:BackgroundTaskEntry">
      <Grid ColumnSpacing="8" Padding="4,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="1">
          <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Bind local:HubFormat.StateText(State)}" VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ComboBox Grid.Column="2" Width="100" Tag="{x:Bind Id}" SelectedIndex="{x:Bind local:HubFormat.PriorityIndex(Priority)}"
                  SelectionChanged="OnTaskPriorityChanged" AutomationProperties.Name="Priority"
                  Visibility="{x:Bind local:HubFormat.ShowBar(CanPause)}">
          <ComboBoxItem Content="Low" />
          <ComboBoxItem Content="Normal" />
          <ComboBoxItem Content="High" />
        </ComboBox>
        <Button Grid.Column="3" Content="{x:Bind local:HubFormat.PauseText(CanResume)}" Tag="{x:Bind Id}" Click="OnTaskPauseResumeClick"
                Visibility="{x:Bind local:HubFormat.ShowBar(CanPauseOrResume)}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border x:Name="Frame" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The grip on the top edge (fly-up and bottom dock) or the left edge (right dock): drag to resize. -->
      <local:HubGrip x:Name="TopGrip" Grid.Row="0" Grid.Column="1" Vertical="False" />
      <local:HubGrip x:Name="LeftGrip" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Vertical="True" Visibility="Collapsed" />

      <Grid Grid.Row="1" Grid.Column="1" Padding="12,2,8,2" ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <SelectorBar x:Name="Tabs" SelectionChanged="OnTabSelected">
          <SelectorBarItem x:Name="OperationsItem" Text="Operations" Tag="Operations" />
          <SelectorBarItem Text="Activity" Tag="Activity" />
          <SelectorBarItem Text="Background" Tag="Background" />
          <SelectorBarItem Text="Soft-delete bin" Tag="Deleted" />
          <SelectorBarItem Text="Quick settings" Tag="QuickSettings" />
          <SelectorBarItem Text="Space" Tag="Space" />
        </SelectorBar>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <ToggleButton x:Name="PinButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="OnPinClick" AutomationProperties.Name="Keep open"
                        ToolTipService.ToolTip="Keep open: stays up until you close it" />
          <Button x:Name="PlaceButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                  AutomationProperties.Name="Where to show it" ToolTipService.ToolTip="Fly-up, dock or its own window">
            <Button.Flyout>
              <MenuFlyout x:Name="PlaceMenu" Opening="OnPlaceMenuOpening" />
            </Button.Flyout>
          </Button>
          <Button x:Name="CloseButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                  Click="OnCloseClick" AutomationProperties.Name="Close" ToolTipService.ToolTip="Close (Esc)" />
        </StackPanel>
      </Grid>

      <Grid x:Name="Pages" Grid.Row="2" Grid.Column="1" Padding="12,4,12,8">
        <Grid x:Name="OperationsPage" RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="OperationsSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="QueueEtaText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button x:Name="PauseAllOpsButton" Content="Pause all" Click="OnPauseAllJobsClick" />
              <Button x:Name="ResumeAllOpsButton" Content="Resume all" Click="OnResumeAllJobsClick" />
              <Button x:Name="ClearButton" Content="Clear completed" Click="OnClearClick" />
            </StackPanel>
          </Grid>
          <!-- Acts on the selected jobs (Ctrl and Shift select several); each button is on when it fits at least one of them. -->
          <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button x:Name="OpPauseButton" Content="Pause" Tag="Pause" Click="OnSelectionActionClick" />
              <Button x:Name="OpResumeButton" Content="Resume" Tag="Resume" Click="OnSelectionActionClick" />
              <Button x:Name="OpRunNowButton" Content="Run now" Tag="RunNow" Click="OnSelectionActionClick" ToolTipService.ToolTip="Start now, above the limits" />
              <Button x:Name="OpUpButton" Content="Move up" Tag="MoveUp" Click="OnSelectionActionClick" />
              <Button x:Name="OpDownButton" Content="Move down" Tag="MoveDown" Click="OnSelectionActionClick" />
              <Button x:Name="OpCancelButton" Content="Cancel" Tag="Cancel" Click="OnSelectionActionClick" />
              <Button x:Name="OpRemoveButton" Content="Remove" Tag="Remove" Click="OnSelectionActionClick" ToolTipService.ToolTip="Take off the list" />
            </StackPanel>
          </ScrollViewer>
          <ListView x:Name="OperationList" Grid.Row="2" SelectionMode="Extended" ItemTemplateSelector="{StaticResource OperationSelector}"
                    SelectionChanged="OnOperationSelectionChanged" RightTapped="OnOperationRightTapped" />
          <TextBlock x:Name="NothingText" Grid.Row="2" Text="Nothing is running. Copies, moves and deletes appear here."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,12,0,0" Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="ActivityPage" RowSpacing="6" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="KindBox" Width="130" SelectedIndex="0" SelectionChanged="OnActivityFilterChanged" AutomationProperties.Name="Kind">
              <ComboBoxItem Content="All kinds" />
              <ComboBoxItem Content="Navigation" Tag="Navigation" />
              <ComboBoxItem Content="Files" Tag="Files" />
              <ComboBoxItem Content="Tabs" Tag="Tabs" />
              <ComboBoxItem Content="View" Tag="View" />
              <ComboBoxItem Content="Settings" Tag="Settings" />
              <ComboBoxItem Content="Messages" Tag="Message" />
            </ComboBox>
            <TextBox x:Name="ActivitySearch" Grid.Column="1" PlaceholderText="Search the log" TextChanged="OnActivitySearchChanged" AutomationProperties.Name="Search the log" />
            <CheckBox x:Name="EarlierBox" Grid.Column="2" Content="Earlier sessions" MinWidth="0" Click="OnEarlierClick"
                      ToolTipService.ToolTip="Include the last seven days from earlier runs" />
            <Button x:Name="UndoActivityButton" Grid.Column="3" Content="Undo last" Click="OnUndoLastClick" ToolTipService.ToolTip="Undo the last file action (Ctrl+Z)" />
            <Button Grid.Column="4" Content="Copy or export" AutomationProperties.Name="Copy or export">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="Copy as text" Click="OnCopyTextClick" />
                  <MenuFlyoutItem Text="Copy as JSON" Click="OnCopyJsonClick" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Export to a file…" Click="OnExportClick" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Clear the log" Click="OnClearActivityClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <ListView x:Name="ActivityList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnActivityItemClick"
                    ItemTemplate="{StaticResource ActivityTemplate}" />
          <TextBlock x:Name="ActivityEmpty" Grid.Row="1" Text="Nothing here yet. What you do is listed here, newest first." Margin="4,12,0,0"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="DeletedPage" RowSpacing="6" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BinSummary" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Refresh" Click="OnBinRefreshClick" />
            <Button Grid.Column="2" Content="Delete old now" Click="OnBinPurgeOldClick"
                    ToolTipService.ToolTip="Apply the age and size limits from Settings to the bin now" />
          </Grid>
          <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BinRestoreButton" Content="Restore" IsEnabled="False" Click="OnBinRestoreClick"
                    ToolTipService.ToolTip="Put the selected items back where they were deleted from" />
            <Button x:Name="BinDeleteButton" Grid.Column="1" Content="Delete permanently" IsEnabled="False" Click="OnBinPurgeClick"
                    ToolTipService.ToolTip="Delete the selected items for good" />
            <TextBox x:Name="BinSearch" Grid.Column="2" PlaceholderText="Search the bin" TextChanged="OnBinSearchChanged" AutomationProperties.Name="Search the bin" />
          </Grid>
          <TextBlock x:Name="BinMessage" Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
          <ListView x:Name="BinList" Grid.Row="3" SelectionMode="Extended" ItemTemplate="{StaticResource BinTemplate}"
                    SelectionChanged="OnBinSelectionChanged" />
        </Grid>
        <ScrollViewer x:Name="BackgroundPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Padding="0,0,8,8">
            <StackPanel Spacing="4">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Folder sizes and other background work" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="PauseAllButton" Grid.Column="1" Content="Pause all" Click="OnPauseAllClick" />
                <Button x:Name="ResumeAllButton" Grid.Column="2" Content="Resume all" Click="OnResumeAllClick" />
              </Grid>
              <TextBlock x:Name="FolderSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <ListView x:Name="TaskList" SelectionMode="None" ItemTemplate="{StaticResource TaskTemplate}" MaxHeight="260" />
              <TextBlock x:Name="TasksEmpty" Text="No background work right now." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Thumbnails" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock x:Name="ThumbText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Video and audio details" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock x:Name="MediaText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <ItemsControl x:Name="QuarantineList" ItemTemplate="{StaticResource QuarantineTemplate}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Network folders" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock x:Name="NetworkText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Programs this app runs" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <ItemsControl x:Name="ProcessList" ItemTemplate="{StaticResource ProcessTemplate}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="QuickSettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Padding="0,0,8,8" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="How much runs at once" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="16" RowSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <NumberBox x:Name="RunningBox" Header="Copies, moves and deletes" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" SmallChange="1"
                         ValueChanged="OnQuickNumberChanged" ToolTipService.ToolTip="All together, on every drive" />
              <NumberBox x:Name="PerDeviceBox" Grid.Column="1" Header="On one drive or share" Minimum="1" Maximum="4" SpinButtonPlacementMode="Inline" SmallChange="1"
                         ValueChanged="OnQuickNumberChanged" ToolTipService.ToolTip="One at a time is kindest to a NAS" />
              <NumberBox x:Name="BackgroundBox" Grid.Column="2" Header="Background work" Minimum="1" Maximum="8" SpinButtonPlacementMode="Inline" SmallChange="1"
                         ValueChanged="OnQuickNumberChanged" ToolTipService.ToolTip="Folder sizes, thumbnails and the like" />
            </Grid>
            <TextBlock Text="On network drives" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ToggleSwitch x:Name="NetworkSizesSwitch" Header="Count the size of folders" Toggled="OnQuickToggled"
                          ToolTipService.ToolTip="Each folder means walking the whole share. Turn off to spare a slow NAS." />
            <ToggleSwitch x:Name="NetworkThumbsSwitch" Header="Make thumbnails of files" Toggled="OnQuickToggled"
                          ToolTipService.ToolTip="Each thumbnail means reading the file over the network." />
            <TextBlock Text="Copy speed" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <NumberBox x:Name="BandwidthBox" Header="Limit for all copies and moves (MB/s, 0 = none)" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Inline" SmallChange="10"
                       ValueChanged="OnQuickSpeedChanged" ToolTipService.ToolTip="Leaves room on the network for everything else. The slowest limit that applies wins." />
            <ToggleSwitch x:Name="ScheduleSwitch" Header="A different limit at set times" Toggled="OnQuickSpeedToggled" />
            <Grid x:Name="ScheduleGrid" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TimePicker x:Name="ScheduleFromPicker" Header="From" ClockIdentifier="24HourClock" MinuteIncrement="15" SelectedTimeChanged="OnQuickScheduleTimeChanged" />
              <TimePicker x:Name="ScheduleToPicker" Grid.Column="1" Header="To" ClockIdentifier="24HourClock" MinuteIncrement="15" SelectedTimeChanged="OnQuickScheduleTimeChanged" />
              <NumberBox x:Name="ScheduleBox" Grid.Column="2" Header="Limit then (MB/s, 0 = none)" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Inline" SmallChange="10"
                         ValueChanged="OnQuickSpeedChanged" />
            </Grid>
            <ComboBox x:Name="VerifyBox" Header="Check copies against the original" SelectionChanged="OnVerifyChanged" MinWidth="320">
              <ComboBoxItem Content="Moves and network copies (recommended)" Tag="Default" />
              <ComboBoxItem Content="Every file in full" Tag="Full" />
              <ComboBoxItem Content="Moves only" Tag="Off" />
            </ComboBox>
            <HyperlinkButton Content="All settings…" Click="OnAllSettingsClick" Padding="0" />
          </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="SpacePage" Text="The space map of this folder arrives with Phase 4." TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,12,0,0" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
