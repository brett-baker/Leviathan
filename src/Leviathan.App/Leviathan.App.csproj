<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 UI process. Phase 0 is a shell that proves the worker connection, the job queue and diagnostics end to end. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(MinimalWindowsVersion)</TargetPlatformMinVersion>
    <RootNamespace>Leviathan.App</RootNamespace>
    <AssemblyName>Leviathan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged (decision D28): runs straight from the build output, Windows App SDK bundled with the app. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>

    <!-- The UI project awaits on the UI thread on purpose. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <!-- Icon packs (spec 4.3): plain folders of SVGs plus a pack.json, copied next to Leviathan.exe so a pack can be added or replaced without a rebuild. -->
  <ItemGroup>
    <Content Include="Assets\Icons\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Leviathan.Contracts\Leviathan.Contracts.csproj" />
    <ProjectReference Include="..\Leviathan.Engine\Leviathan.Engine.csproj" />
    <ProjectReference Include="..\Leviathan.Data\Leviathan.Data.csproj" />
    <ProjectReference Include="..\Leviathan.Diagnostics\Leviathan.Diagnostics.csproj" />
    <ProjectReference Include="..\Leviathan.Ipc\Leviathan.Ipc.csproj" />
    <ProjectReference Include="..\Leviathan.Core\Leviathan.Core.csproj" />
    <ProjectReference Include="..\Leviathan.ViewModels\Leviathan.ViewModels.csproj" />
    <ProjectReference Include="..\Leviathan.Providers.Local\Leviathan.Providers.Local.csproj" />
    <ProjectReference Include="..\Leviathan.Providers.Cloud\Leviathan.Providers.Cloud.csproj" />
    <ProjectReference Include="..\Leviathan.Interop\Leviathan.Interop.csproj" />
    <!-- Builds the worker and copies it next to Leviathan.exe so the UI can start it. -->
    <ProjectReference Include="..\Leviathan.Worker\Leviathan.Worker.csproj" />
    <!-- Same for the shell host, which runs third-party shell extensions out of process. -->
    <ProjectReference Include="..\Leviathan.ShellHost\Leviathan.ShellHost.csproj" />
  </ItemGroup>
</Project>
