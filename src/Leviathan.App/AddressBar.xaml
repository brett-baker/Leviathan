<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.AddressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:paths="using:Leviathan.Core.Paths"
    xmlns:local="using:Leviathan.App">

  <UserControl.Resources>
    <DataTemplate x:Key="FolderItemTemplate" x:DataType="paths:LocationPath">
      <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
        <ContentControl IsTabStop="False" Content="{x:Bind local:SidebarFormat.FolderIcon()}" />
        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The frame looks like a text box; inside it is either the breadcrumb row or the editor (spec 5.2). -->
  <Grid x:Name="Frame"
        Height="32"
        MinWidth="160"
        CornerRadius="4"
        Background="{ThemeResource ControlFillColorDefaultBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        Tapped="OnFrameTapped"
        RightTapped="OnFrameRightTapped"
        SizeChanged="OnFrameSizeChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" Padding="4,0" VerticalAlignment="Center" />
    <!-- The favorite star (spec 5.2): outlined when this folder is not a favorite, filled when it is. -->
    <Button x:Name="StarButton" Grid.Column="1" Width="30" Height="30" Padding="0" Margin="0,0,1,0" Background="Transparent" BorderThickness="0"
            VerticalAlignment="Center" Click="OnStarClick" RightTapped="OnStarRightTapped"
            AutomationProperties.Name="Favorite">
      <ContentControl x:Name="StarIcon" IsTabStop="False" />
    </Button>
    <AutoSuggestBox x:Name="Editor"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    PlaceholderText="Type a path, \\server\share, sftp://host or shell:Downloads"
                    AutomationProperties.Name="Address"
                    TextChanged="OnEditorTextChanged"
                    QuerySubmitted="OnEditorQuerySubmitted"
                    LostFocus="OnEditorLostFocus"
                    PreviewKeyDown="OnEditorPreviewKeyDown" />
  </Grid>
</UserControl>
