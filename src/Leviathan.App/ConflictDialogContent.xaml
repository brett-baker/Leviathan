<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.ConflictDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hub="using:Leviathan.ViewModels.Hub">

  <!-- The one conflict dialog of a job (spec 12.4): a rule for all, rules for single files, and a Compare flyout per file. -->
  <StackPanel Spacing="10" MinWidth="560">
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="For all of them" VerticalAlignment="Center" />
      <ComboBox x:Name="ForAllBox" Grid.Column="1" MinWidth="220" DisplayMemberPath="Label" SelectionChanged="OnForAllChanged"
                AutomationProperties.Name="Rule for all conflicts" />
    </Grid>
    <TextBlock x:Name="UnlistedText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <TextBlock Text="Or choose for single files" Style="{StaticResource CaptionTextBlockStyle}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <ListView x:Name="RowList" SelectionMode="None" MaxHeight="300">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="hub:ConflictRow">
          <Grid ColumnSpacing="8" Padding="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1">
              <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="{x:Bind Hint}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind hub:ConflictRow.RuleChoices}" SelectedIndex="{x:Bind RuleIndex, Mode=TwoWay}" MinWidth="160"
                      VerticalAlignment="Center" AutomationProperties.Name="Rule for this file" />
            <Button Grid.Column="2" Content="Compare" Tag="{x:Bind}" Click="OnCompareClick" VerticalAlignment="Center" Padding="10,4" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </StackPanel>
</UserControl>
