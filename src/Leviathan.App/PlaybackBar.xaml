<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Leviathan.App.PlaybackBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Spec 9: the playback controls are buttons with tooltips that give their shortcut. -->
  <StackPanel Spacing="2">
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TimeText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Text="0:00 / 0:00" />
      <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.001" VerticalAlignment="Center"
              ValueChanged="OnSeekChanged" IsTabStop="False" AutomationProperties.Name="Position" />
      <TextBlock x:Name="SpeedText" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Text="1×" MinWidth="30" TextAlignment="Right" />
    </Grid>
    <Grid x:Name="Buttons" ColumnSpacing="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Content="−5m" Click="OnBack5" ToolTipService.ToolTip="Back 5 minutes (Ctrl+Left)" AutomationProperties.Name="Back 5 minutes" />
      <Button Grid.Column="1" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Content="−1m" Click="OnBack1" ToolTipService.ToolTip="Back 1 minute (Shift+Left)" AutomationProperties.Name="Back 1 minute" />
      <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Content="−30s" Click="OnBack30" ToolTipService.ToolTip="Back 30 seconds (Left)" AutomationProperties.Name="Back 30 seconds" />
      <Button Grid.Column="3" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Click="OnPlay" ToolTipService.ToolTip="Play or pause (Space)" AutomationProperties.Name="Play or pause">
        <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="12" />
      </Button>
      <Button Grid.Column="4" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Content="+30s" Click="OnFwd30" ToolTipService.ToolTip="Forward 30 seconds (Right)" AutomationProperties.Name="Forward 30 seconds" />
      <Button Grid.Column="5" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Content="+1m" Click="OnFwd1" ToolTipService.ToolTip="Forward 1 minute (Shift+Right)" AutomationProperties.Name="Forward 1 minute" />
      <Button Grid.Column="6" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Content="+5m" Click="OnFwd5" ToolTipService.ToolTip="Forward 5 minutes (Ctrl+Right)" AutomationProperties.Name="Forward 5 minutes" />
      <Button Grid.Column="7" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" Content="»" Click="OnSkim" ToolTipService.ToolTip="Skim forward: 1×, 2×, 4×, 8× (L)" AutomationProperties.Name="Skim forward" />
    </Grid>
  </StackPanel>
</UserControl>
