<Project Sdk="Microsoft.NET.Sdk">
  <!-- File-operations worker process (spec §2.2): job queue, journal, folder sizes. Survives UI crashes and window closes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <RootNamespace>Leviathan.Worker</RootNamespace>
    <AssemblyName>Leviathan.Worker</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Leviathan.Core\Leviathan.Core.csproj" />
    <ProjectReference Include="..\Leviathan.Contracts\Leviathan.Contracts.csproj" />
    <ProjectReference Include="..\Leviathan.Engine\Leviathan.Engine.csproj" />
    <ProjectReference Include="..\Leviathan.Diagnostics\Leviathan.Diagnostics.csproj" />
    <ProjectReference Include="..\Leviathan.Providers.Local\Leviathan.Providers.Local.csproj" />
    <ProjectReference Include="..\Leviathan.Data\Leviathan.Data.csproj" />
    <ProjectReference Include="..\Leviathan.Ipc\Leviathan.Ipc.csproj" />
    <ProjectReference Include="..\Leviathan.Interop\Leviathan.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Leviathan.Integration.Tests" />
  </ItemGroup>
</Project>
