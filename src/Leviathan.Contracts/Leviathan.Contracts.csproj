<Project Sdk="Microsoft.NET.Sdk">
  <!-- IPC contracts shared by the UI and the worker processes. Plain interfaces and records; transport-agnostic (spec §2.2). -->
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <RootNamespace>Leviathan.Contracts</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The media contract carries MediaInfo itself; Media.Core is plain net10.0 with no dependencies. -->
    <ProjectReference Include="..\Leviathan.Media.Core\Leviathan.Media.Core.csproj" />
  </ItemGroup>
</Project>
