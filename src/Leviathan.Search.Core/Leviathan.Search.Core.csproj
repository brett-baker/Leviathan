<Project Sdk="Microsoft.NET.Sdk">
  <!-- Search without a UI: query model, parser, matcher, saved searches (spec 13). Plain net10.0 so it is unit-tested everywhere. -->
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <RootNamespace>Leviathan.Search</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Leviathan.Search.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Leviathan.Core\Leviathan.Core.csproj" />
  </ItemGroup>
</Project>
