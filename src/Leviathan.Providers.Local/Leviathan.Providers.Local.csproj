<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local drives and SMB/UNC paths. Win32 FindFirstFileExW (large fetch) for network paths; .NET's NtQueryDirectoryFile-based enumerator for local disks. -->
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <RootNamespace>Leviathan.Providers.Local</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Leviathan.Core\Leviathan.Core.csproj" />
  </ItemGroup>
</Project>
