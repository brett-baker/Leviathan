<Project Sdk="Microsoft.NET.Sdk">
  <!-- CsWin32-generated Win32 and COM bindings (shell, file system, network). Callers use Leviathan interfaces, never these types directly (spec §2.3, §2.4). -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <RootNamespace>Leviathan.Interop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Leviathan.Core\Leviathan.Core.csproj" />
    <ProjectReference Include="..\Leviathan.Contracts\Leviathan.Contracts.csproj" />
    <ProjectReference Include="..\Leviathan.Engine\Leviathan.Engine.csproj" />
    <ProjectReference Include="..\Leviathan.Search.Core\Leviathan.Search.Core.csproj" />
    <ProjectReference Include="..\Leviathan.Providers.Remote\Leviathan.Providers.Remote.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
    <AdditionalFiles Include="NativeMethods.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Leviathan.Interop.Tests" />
  </ItemGroup>
</Project>
