<Project Sdk="Microsoft.NET.Sdk">
  <!-- Media metadata without a UI: finds and runs ffprobe, parses its JSON, caches results (spec 9.3). Plain net10.0 so it is unit-tested everywhere. -->
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <RootNamespace>Leviathan.Media</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Leviathan.Media.Tests" />
  </ItemGroup>
</Project>
